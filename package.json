{
  "name": "modhub",
  "version": "0.1.0",
  "description": "一體式 3DMigoto/XXMI MOD 整合管理器（星穹鐵道 / 鳴潮 / 絕區零）",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "node-unrar-js": "^2.0.2",
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
