{
  "name": "modhub",
  "version": "0.1.3",
  "description": "一體式 3DMigoto/XXMI MOD 整合管理器（星穹鐵道 / 鳴潮 / 絕區零 / 終末地）",
  "license": "MIT",
  "author": "yangmo-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangmo-lang/ModHub.git"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test test/",
    "dist": "vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.8.11",
    "node-unrar-js": "^2.0.2",
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "productName": "ModHub",
  "build": {
    "appId": "local.modhub.app",
    "productName": "ModHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "npmRebuild": false,
    "electronVersion": "33.4.11",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ModHub-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ModHub-Setup-${version}.exe",
      "shortcutName": "ModHub",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yangmo-lang",
        "repo": "ModHub",
        "releaseType": "release"
      }
    ]
  }
}
